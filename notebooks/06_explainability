{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyMEHKMAHBWLxgDn5fSHMRNq"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"id":"AACNpky_d5LI","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792334915074,"user_tz":-330,"elapsed":147259,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"97b552bb-ee41-4612-92bb-aded86b92e62"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Val AUROC adjusted: 0.994 (expect about 0.994)\n"]}],"source":["# CELL 6.1 - Header, data, weights, load chosen model\n","from google.colab import drive, userdata\n","drive.mount('/content/drive')\n","import sys, shutil, importlib, json\n","sys.path.insert(0, '/content/drive/MyDrive/xray-classifier/src')\n","from project_setup import *\n","\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import torch.nn as nn\n","from PIL import Image\n","import xray_data, models, train_utils, shortcut\n","\n","set_seed()\n","CONFIG = load_config()\n","FIG = PATHS[\"docs\"] / \"figures\"\n","\n","LOCAL = Path(\"/content/img256\")\n","if not LOCAL.exists():\n","    shutil.copytree(PATHS[\"processed\"] / \"img256\", LOCAL)\n","\n","splits = pd.read_csv(PATHS[\"configs\"] / \"splits.csv\")\n","loaders = xray_data.make_loaders(splits, LOCAL, CONFIG[\"img_size\"], CONFIG[\"batch_size\"], seed=SEED)\n","\n","edges = shortcut.fit_bin_edges(splits[splits.partition == \"train\"])\n","val_df = splits[splits.partition == \"val\"].reset_index(drop=True)\n","W_val = shortcut.compute_weights(val_df, shortcut.assign_bins(val_df, edges))\n","y_v = val_df.target.to_numpy()\n","\n","net = models.DenseNetClassifier(pretrained=False).to(DEVICE)\n","net.load_state_dict(torch.load(PATHS[\"models\"] / \"densenet_sizebalanced.pt\", map_location=DEVICE))\n","net.eval()\n","probs_v, _ = train_utils.predict(net, loaders[\"val\"], DEVICE)\n","print(\"Val AUROC adjusted:\", round(shortcut.weighted_metrics(probs_v, y_v, W_val)[\"auroc\"], 3), \"(expect about 0.994)\")"]},{"cell_type":"code","source":["# CELL 6.2 - src/explain.py\n","module = '''\n","import numpy as np\n","import torch\n","import torch.nn.functional as F\n","\n","H = 224\n","\n","def region_masks(h=H):\n","    central = np.zeros((h, h), bool)\n","    central[int(.2 * h):int(.9 * h), int(.15 * h):int(.85 * h)] = True\n","    c = int(.25 * h)\n","    corners = np.zeros((h, h), bool)\n","    corners[:c, :c] = True\n","    corners[:c, -c:] = True\n","    b = int(.10 * h)\n","    border = np.ones((h, h), bool)\n","    border[b:-b, b:-b] = False\n","    return {\"central\": central, \"periphery\": ~central, \"top_corners\": corners, \"outer_border\": border}\n","\n","def gradcam(net, x):\n","    \"\"\"Grad-CAM for the pneumonia logit on the last DenseNet feature map.\"\"\"\n","    net.eval()\n","    feats = net.net.features(x)\n","    act = F.relu(feats)\n","    logit = net.net.classifier(F.adaptive_avg_pool2d(act, 1).flatten(1)).squeeze(1)\n","    grads = torch.autograd.grad(logit.sum(), act)[0]\n","    w = grads.mean(dim=(2, 3), keepdim=True)\n","    cam = F.relu((w * act).sum(1, keepdim=True))\n","    cam = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=False)[:, 0]\n","    cam = cam - cam.flatten(1).min(1)[0][:, None, None]\n","    cam = cam / (cam.flatten(1).max(1)[0][:, None, None] + 1e-8)\n","    return cam.detach().cpu().numpy(), torch.sigmoid(logit).detach().cpu().numpy()\n","'''\n","f = PATHS[\"src\"] / \"explain.py\"\n","f.write_text(module)\n","compile(f.read_text(), str(f), \"exec\")\n","import explain\n","importlib.reload(explain)\n","print(\"Wrote and syntax-checked src/explain.py\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"z3swFaTSfEn7","executionInfo":{"status":"ok","timestamp":1792334937496,"user_tz":-330,"elapsed":2,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"bbca75ee-5ff2-4a5d-df33-cefd14880901"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Wrote and syntax-checked src/explain.py\n"]}]},{"cell_type":"code","source":["# CELL 6.3 - Grad-CAM examples (validation)\n","pred = (probs_v >= 0.5).astype(int)\n","rng = np.random.default_rng(SEED)\n","groups = {\n","    \"True pneumonia (caught)\": np.where((y_v == 1) & (pred == 1))[0],\n","    \"True normal (cleared)\":   np.where((y_v == 0) & (pred == 0))[0],\n","    \"Missed pneumonia\":        np.where((y_v == 1) & (pred == 0))[0],\n","    \"False alarm\":             np.where((y_v == 0) & (pred == 1))[0],\n","}\n","print({k: len(v) for k, v in groups.items()})\n","picked = {k: rng.choice(v, size=min(4, len(v)), replace=False) for k, v in groups.items() if len(v)}\n","\n","_, eval_tf = xray_data.get_transforms(CONFIG[\"img_size\"])\n","fig, axes = plt.subplots(len(picked), 4, figsize=(12, 3 * len(picked)))\n","axes = np.atleast_2d(axes)\n","for r, (name, idxs) in enumerate(picked.items()):\n","    for c in range(4):\n","        ax = axes[r, c]\n","        ax.axis(\"off\")\n","        if c >= len(idxs):\n","            continue\n","        i = int(idxs[c])\n","        img = Image.open(LOCAL / val_df.cache_name[i]).convert(\"RGB\")\n","        cam, p = explain.gradcam(net, eval_tf(img).unsqueeze(0).to(DEVICE))\n","        ax.imshow(img.resize((224, 224)))\n","        ax.imshow(cam[0], cmap=\"jet\", alpha=0.4)\n","        ax.set_title(f\"{name}\\np(pneumonia)={p[0]:.2f}\", fontsize=8)\n","plt.tight_layout()\n","plt.savefig(FIG / \"gradcam_grid.png\", dpi=150)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":818},"id":"UAAb5mxVfOD9","executionInfo":{"status":"ok","timestamp":1792334957585,"user_tz":-330,"elapsed":7074,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"8936238c-bb68-448b-911e-ace3268fcaae"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["{'True pneumonia (caught)': 621, 'True normal (cleared)': 223, 'Missed pneumonia': 23, 'False alarm': 4}\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/torch/autograd/graph.py:869: UserWarning: Attempting to run cuBLAS, but there was no current CUDA context! Attempting to set the primary context... (Triggered internally at /pytorch/aten/src/ATen/cuda/CublasHandlePool.cpp:335.)\n","  return Variable._execution_engine.run_backward(  # Calls into the C++ engine to run the backward pass\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x1200 with 16 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# CELL 6.4 - Where does the heat sit? (proxy: fixed regions, no lung masks)\n","masks = explain.region_masks()\n","area = {k: float(m.mean()) for k, m in masks.items()}\n","\n","# Check the regions look sensible on three images\n","fig, axes = plt.subplots(1, 3, figsize=(10, 3.5))\n","for ax, i in zip(axes, [0, 300, 600]):\n","    img = Image.open(LOCAL / val_df.cache_name[i]).convert(\"L\").resize((224, 224))\n","    ax.imshow(img, cmap=\"gray\"); ax.axis(\"off\")\n","    ax.contour(masks[\"central\"].astype(float), levels=[0.5], colors=\"lime\")\n","    ax.contour(masks[\"top_corners\"].astype(float), levels=[0.5], colors=\"red\")\n","plt.tight_layout(); plt.savefig(FIG / \"region_masks.png\", dpi=150); plt.show()\n","\n","cams = []\n","for xb, _ in loaders[\"val\"]:\n","    cam, _p = explain.gradcam(net, xb.to(DEVICE))\n","    cams.append(cam)\n","cams = np.concatenate(cams)\n","\n","mass = {k: (cams * m).sum((1, 2)) / (cams.sum((1, 2)) + 1e-8) for k, m in masks.items()}\n","rows = []\n","for k in [\"central\", \"periphery\", \"top_corners\", \"outer_border\"]:\n","    for lab, name in [(1, \"PNEUMONIA\"), (0, \"NORMAL\")]:\n","        med = float(np.median(mass[k][y_v == lab]))\n","        rows.append({\"region\": k, \"class\": name, \"area share\": round(area[k], 3),\n","                     \"heat share (median)\": round(med, 3), \"ratio vs area\": round(med / area[k], 2)})\n","attn = pd.DataFrame(rows)\n","print(attn.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":417},"id":"8XXyGmoUfg8r","executionInfo":{"status":"ok","timestamp":1792335048808,"user_tz":-330,"elapsed":4813,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"e5f12206-0312-4511-8c0a-4051fae25bd8"},"execution_count":4,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x350 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["      region     class  area share  heat share (median)  ratio vs area\n","     central PNEUMONIA       0.491                0.652           1.33\n","     central    NORMAL       0.491                0.001           0.00\n","   periphery PNEUMONIA       0.509                0.348           0.68\n","   periphery    NORMAL       0.509                0.000           0.00\n"," top_corners PNEUMONIA       0.125                0.076           0.61\n"," top_corners    NORMAL       0.125                0.000           0.00\n","outer_border PNEUMONIA       0.354                0.214           0.60\n","outer_border    NORMAL       0.354                0.000           0.00\n"]}]},{"cell_type":"code","source":["# CELL 6.5 - Occlusion tests (validation, size-adjusted metrics)\n","mean_t = torch.tensor(xray_data.IMAGENET_MEAN, device=DEVICE)[None, :, None, None]\n","std_t = torch.tensor(xray_data.IMAGENET_STD, device=DEVICE)[None, :, None, None]\n","black = (0 - mean_t) / std_t\n","\n","variants = {\n","    \"none (baseline)\": None,\n","    \"top corners masked\": masks[\"top_corners\"],\n","    \"outer 10% border masked\": masks[\"outer_border\"],\n","    \"center masked (periphery only visible)\": masks[\"central\"],\n","    \"periphery masked (center only visible)\": masks[\"periphery\"],\n","}\n","\n","@torch.no_grad()\n","def probs_with_mask(mask):\n","    net.eval()\n","    out = []\n","    m = None if mask is None else torch.tensor(mask, device=DEVICE)[None, None]\n","    for xb, _ in loaders[\"val\"]:\n","        x = xb.to(DEVICE)\n","        if m is not None:\n","            x = torch.where(m, black.expand_as(x), x)\n","        out.append(torch.sigmoid(net(x)).cpu())\n","    return torch.cat(out).numpy()\n","\n","rows = []\n","for name, mk in variants.items():\n","    p = probs_with_mask(mk)\n","    a = shortcut.weighted_metrics(p, y_v, W_val)\n","    u = train_utils.metrics_at(p, y_v)\n","    rows.append({\"variant\": name, \"AUROC standard\": u[\"auroc\"], \"AUROC adjusted\": a[\"auroc\"],\n","                 \"recall adj\": a[\"recall\"], \"specificity adj\": a[\"specificity\"]})\n","occ = pd.DataFrame(rows).round(3)\n","print(occ.to_string(index=False))\n","occ.to_csv(PATHS[\"docs\"] / \"results\" / \"occlusion_val.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7-6Tiue1fvty","executionInfo":{"status":"ok","timestamp":1792335114763,"user_tz":-330,"elapsed":18187,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"02f79cd1-a282-408f-acc0-f41d6db3a4b9"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["                               variant  AUROC standard  AUROC adjusted  recall adj  specificity adj\n","                       none (baseline)           0.997           0.994       0.931            0.986\n","                    top corners masked           0.996           0.992       0.930            0.986\n","               outer 10% border masked           0.994           0.991       0.978            0.901\n","center masked (periphery only visible)           0.961           0.897       1.000            0.007\n","periphery masked (center only visible)           0.990           0.985       0.993            0.683\n"]}]},{"cell_type":"code","source":["# CELL 6.6 (replacement) - Phase 6 decisions\n","entries = f\"\"\"\n","## Decision 38: Grad-CAM on the last DenseNet feature map, inspected on validation images\n","- Why: shows where the model looks; examples drawn from caught, cleared, missed and false-alarm groups\n","- Figure: docs/figures/gradcam_grid.png\n","\n","## Decision 39: Quantify attention with fixed regions, compared with each region's area share\n","- Regions: central chest box, periphery, top corners (where text markers sit), outer 10% border\n","- Limitation: no lung masks, so this is a proxy. The pneumonia heatmap is empty for normal predictions, so only pneumonia images are summarized here\n","\n","## Decision 40: Occlusion tests on validation with size-adjusted metrics\n","- Why: a causal check of reliance on markers, borders and lungs. Black rectangles also shift the input distribution, so compare variants with each other\n","\"\"\"\n","append_decision(entries)\n","print(\"Decisions logged (duplicates skipped).\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qWxlkBXif4xJ","executionInfo":{"status":"ok","timestamp":1792335627622,"user_tz":-330,"elapsed":7,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"4f476368-0eb4-4fc2-83aa-7ec8a92b8cd7"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Decisions logged (duplicates skipped).\n"]}]},{"cell_type":"code","source":["# CELL 6.7 - Push Phase 6\n","git_push(\"Phase 6: Grad-CAM, attention regions, occlusion tests, decisions\",\n","         userdata.get(\"GITHUB_USERNAME\"),\n","         userdata.get(\"GITHUB_TOKEN\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GuwVOTachq4t","executionInfo":{"status":"ok","timestamp":1792335683289,"user_tz":-330,"elapsed":21297,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"937df2ab-cbf7-42ba-b1b5-47f3bf2699f5"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["[main bf9e1a6] Phase 6: Grad-CAM, attention regions, occlusion tests, decisions\n"," 6 files changed, 50 insertions(+), 1 deletion(-)\n"," create mode 100644 docs/figures/gradcam_grid.png\n"," create mode 100644 docs/figures/region_masks.png\n"," create mode 100644 docs/results/occlusion_val.csv\n"," create mode 100644 src/explain.py\n","\n","To https://github.com/AbhimanyuNair/xray-classifier.git\n","   afebd66..bf9e1a6  HEAD -> main\n","\n"]}]},{"cell_type":"code","source":["# CELL 6.8 - Why does the model say NORMAL? + bottom-corner occlusion\n","import torch.nn.functional as F\n","\n","def gradcam_signed(net, x, sign=-1.0):\n","    net.eval()\n","    act = F.relu(net.net.features(x))\n","    logit = net.net.classifier(F.adaptive_avg_pool2d(act, 1).flatten(1)).squeeze(1)\n","    grads = torch.autograd.grad((sign * logit).sum(), act)[0]\n","    w = grads.mean(dim=(2, 3), keepdim=True)\n","    cam = F.relu((w * act).sum(1, keepdim=True))\n","    cam = F.interpolate(cam, size=x.shape[-2:], mode=\"bilinear\", align_corners=False)[:, 0]\n","    cam = cam - cam.flatten(1).min(1)[0][:, None, None]\n","    cam = cam / (cam.flatten(1).max(1)[0][:, None, None] + 1e-8)\n","    return cam.detach().cpu().numpy()\n","\n","cams_n = np.concatenate([gradcam_signed(net, xb.to(DEVICE)) for xb, _ in loaders[\"val\"]])\n","mass_n = {k: (cams_n * m).sum((1, 2)) / (cams_n.sum((1, 2)) + 1e-8) for k, m in masks.items()}\n","rows = []\n","for k in [\"central\", \"periphery\", \"top_corners\", \"outer_border\"]:\n","    med = float(np.median(mass_n[k][y_v == 0]))\n","    rows.append({\"region\": k, \"class\": \"NORMAL (evidence for normal)\", \"area share\": round(area[k], 3),\n","                 \"heat share (median)\": round(med, 3), \"ratio vs area\": round(med / area[k], 2)})\n","attn_n = pd.DataFrame(rows)\n","print(attn_n.to_string(index=False))\n","\n","idx_n = rng.choice(np.where((y_v == 0) & (pred == 0))[0], size=8, replace=False)\n","fig, axes = plt.subplots(2, 4, figsize=(12, 6))\n","for ax, i in zip(axes.flat, idx_n):\n","    i = int(i)\n","    img = Image.open(LOCAL / val_df.cache_name[i]).convert(\"RGB\").resize((224, 224))\n","    ax.imshow(img); ax.imshow(cams_n[i], cmap=\"jet\", alpha=0.4); ax.axis(\"off\")\n","    ax.set_title(f\"p(pneumonia)={probs_v[i]:.2f}\", fontsize=8)\n","plt.tight_layout(); plt.savefig(FIG / \"gradcam_normal_evidence.png\", dpi=150); plt.show()\n","\n","# Bottom corners (15%) masked\n","c = int(.15 * 224)\n","bottom = np.zeros((224, 224), bool)\n","bottom[-c:, :c] = True\n","bottom[-c:, -c:] = True\n","p_b = probs_with_mask(bottom)\n","print(\"Bottom corners masked, adjusted AUROC:\", round(shortcut.weighted_metrics(p_b, y_v, W_val)[\"auroc\"], 3),\n","      \"(baseline 0.994)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":737},"id":"9uhpN4LTiBP4","executionInfo":{"status":"ok","timestamp":1792335738466,"user_tz":-330,"elapsed":11347,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"721f8272-0e85-414c-936c-8e01f1acd5bb"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["      region                        class  area share  heat share (median)  ratio vs area\n","     central NORMAL (evidence for normal)       0.491                0.673           1.37\n","   periphery NORMAL (evidence for normal)       0.509                0.327           0.64\n"," top_corners NORMAL (evidence for normal)       0.125                0.045           0.36\n","outer_border NORMAL (evidence for normal)       0.354                0.197           0.56\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 8 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Bottom corners masked, adjusted AUROC: 0.993 (baseline 0.994)\n"]}]},{"cell_type":"code","source":["# CELL 6.9 - Probe models: train on periphery only vs center only\n","from torch.utils.data import DataLoader, WeightedRandomSampler\n","\n","train_df = splits[splits.partition == \"train\"].reset_index(drop=True)\n","W_tr = shortcut.compute_weights(train_df, shortcut.assign_bins(train_df, edges))\n","train_tf, _ = xray_data.get_transforms(CONFIG[\"img_size\"])\n","\n","def make_train_loader():\n","    g = torch.Generator().manual_seed(SEED)\n","    s = WeightedRandomSampler(torch.tensor(W_tr, dtype=torch.double),\n","                              num_samples=int((W_tr > 0).sum()), replacement=True, generator=g)\n","    return DataLoader(xray_data.XrayDataset(train_df, LOCAL, train_tf), batch_size=CONFIG[\"batch_size\"],\n","                      sampler=s, num_workers=2, pin_memory=True)\n","\n","class MaskedLoader:\n","    def __init__(self, loader, mask):\n","        self.loader = loader\n","        self.mask = torch.tensor(mask)[None, None]\n","        self.dataset = loader.dataset\n","    def __len__(self):\n","        return len(self.loader)\n","    def __iter__(self):\n","        blk = black.cpu()\n","        for x, y in self.loader:\n","            yield torch.where(self.mask, blk.expand_as(x), x), y\n","\n","metric_fn = lambda p, y: shortcut.weighted_metrics(p, y, W_val)\n","\n","def run_probe(name, mask):\n","    set_seed()\n","    ld = {\"train\": MaskedLoader(make_train_loader(), mask), \"val\": MaskedLoader(loaders[\"val\"], mask)}\n","    m = models.DenseNetClassifier().to(DEVICE)\n","    opt = torch.optim.AdamW(m.parameters(), lr=1e-4, weight_decay=1e-4)\n","    train_utils.fit(m, ld, nn.BCEWithLogitsLoss(), opt, DEVICE, epochs=6, patience=3,\n","                    ckpt_path=PATHS[\"models\"] / f\"probe_{name}.pt\", metric_fn=metric_fn)\n","    p, _ = train_utils.predict(m, ld[\"val\"], DEVICE)\n","    a = shortcut.weighted_metrics(p, y_v, W_val)\n","    u = train_utils.metrics_at(p, y_v)\n","    return {\"probe\": name, \"AUROC standard\": u[\"auroc\"], \"AUROC adjusted\": a[\"auroc\"]}\n","\n","probes = pd.DataFrame([\n","    run_probe(\"periphery_only\", masks[\"central\"]),\n","    run_probe(\"center_only\", masks[\"periphery\"]),\n","]).round(3)\n","print(probes.to_string(index=False))\n","print(\"Reference: full model adjusted AUROC 0.994\")\n","probes.to_csv(PATHS[\"docs\"] / \"results\" / \"probe_val.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ym-rjY4viUlY","executionInfo":{"status":"ok","timestamp":1792336290988,"user_tz":-330,"elapsed":510006,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"3d4fc1b3-01eb-4b11-cb0e-1ca94ceb7c8f"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Downloading: \"https://download.pytorch.org/models/densenet121-a639ec97.pth\" to /root/.cache/torch/hub/checkpoints/densenet121-a639ec97.pth\n"]},{"output_type":"stream","name":"stderr","text":["100%|██████████| 30.8M/30.8M [00:00<00:00, 176MB/s]\n"]},{"output_type":"stream","name":"stdout","text":["ep 01 | train 0.349 | val 0.213 | AUROC 0.955 | recall 0.911 | spec 0.860 | 45s  <- best\n","ep 02 | train 0.252 | val 0.172 | AUROC 0.957 | recall 0.925 | spec 0.841 | 41s  <- best\n","ep 03 | train 0.215 | val 0.144 | AUROC 0.963 | recall 0.916 | spec 0.872 | 42s  <- best\n","ep 04 | train 0.181 | val 0.141 | AUROC 0.960 | recall 0.921 | spec 0.847 | 41s\n","ep 05 | train 0.169 | val 0.243 | AUROC 0.963 | recall 0.997 | spec 0.631 | 41s\n","ep 06 | train 0.150 | val 0.156 | AUROC 0.966 | recall 0.908 | spec 0.918 | 41s  <- best\n","ep 01 | train 0.253 | val 0.181 | AUROC 0.989 | recall 0.893 | spec 0.974 | 42s  <- best\n","ep 02 | train 0.140 | val 0.093 | AUROC 0.991 | recall 0.967 | spec 0.939 | 42s  <- best\n","ep 03 | train 0.114 | val 0.118 | AUROC 0.991 | recall 0.991 | spec 0.839 | 42s  <- best\n","ep 04 | train 0.084 | val 0.074 | AUROC 0.994 | recall 0.957 | spec 0.957 | 42s  <- best\n","ep 05 | train 0.074 | val 0.065 | AUROC 0.994 | recall 0.976 | spec 0.926 | 41s\n","ep 06 | train 0.067 | val 0.161 | AUROC 0.990 | recall 0.879 | spec 0.975 | 41s\n","         probe  AUROC standard  AUROC adjusted\n","periphery_only           0.982           0.966\n","   center_only           0.996           0.994\n","Reference: full model adjusted AUROC 0.994\n"]}]},{"cell_type":"code","source":["# CELL 6.10 - Decisions 41 and 42\n","entries = f\"\"\"\n","## Decision 41: Grad-CAM for the NORMAL direction, plus a bottom-corner occlusion test\n","- Why: the pneumonia heatmap is empty for normal predictions, so it cannot explain NORMAL calls\n","- Bottom corners (15%) masked, adjusted AUROC: {shortcut.weighted_metrics(p_b, y_v, W_val)['auroc']:.3f} (baseline 0.994)\n","\n","## Decision 42: Probe models trained only on the periphery or only on the center\n","- Why: measures how much class signal exists outside the central chest. Diagnostic only; the candidate model stays the full DenseNet121 size-balanced unless probes show a serious problem\n","- Reading: periphery-only near the full model means strong class signal outside the central chest (shortcut capacity or peripheral lung tissue); center-only near the full model means the central chest alone is sufficient\n","\"\"\"\n","append_decision(entries)\n","print(\"Decisions logged (duplicates skipped).\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9ekAf7w-kuqr","executionInfo":{"status":"ok","timestamp":1792336853207,"user_tz":-330,"elapsed":19,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"d620c8c6-ed84-411a-bee9-24cbc4c090b6"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Decisions logged (duplicates skipped).\n"]}]},{"cell_type":"code","source":["# CELL 6.12 - Pre-declare the Phase 7 plan, keep the center-only model, push\n","import shutil\n","shutil.copy(PATHS[\"models\"] / \"probe_center_only.pt\", PATHS[\"models\"] / \"densenet_centeronly.pt\")\n","\n","entries = \"\"\"\n","## Decision 43: Two pre-declared models go to the final test evaluation, with the tie-break rule fixed before the test set is opened\n","- Model A: DenseNet121, size-balanced, full image (validation adjusted AUROC 0.994)\n","- Model B: DenseNet121, size-balanced, periphery masked so only the central chest is visible (validation adjusted AUROC 0.994)\n","- Evidence: occlusion and probe tests show the central chest alone is sufficient (occlusion 0.985, probe 0.994), while a periphery-only probe also reaches 0.966, so class signal outside the central chest exists\n","- Rule: if B is within 0.005 adjusted AUROC of A on validation, B is the headline model because it cannot see markers, borders or framing; A is reported as secondary. Both are reported on test, with no switching after seeing test results\n","- Limitation: without lung masks we cannot tell whether the periphery signal is shortcut or peripheral lung tissue\n","- Interview one-liner: \"I fixed the model-choice rule before opening the test set, and chose the model that cannot see acquisition artifacts when performance tied.\"\n","\"\"\"\n","append_decision(entries)\n","\n","git_push(\"Phase 6b: probes, center-only candidate, pre-declared test plan\",\n","         userdata.get(\"GITHUB_USERNAME\"),\n","         userdata.get(\"GITHUB_TOKEN\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"F7yoBXoxmh23","executionInfo":{"status":"ok","timestamp":1792336868304,"user_tz":-330,"elapsed":4224,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"ec6dc47f-998a-4a7f-ceb4-145af7f7915d"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["[main 2d2b219] Phase 6b: probes, center-only candidate, pre-declared test plan\n"," 3 files changed, 19 insertions(+)\n"," create mode 100644 docs/figures/gradcam_normal_evidence.png\n"," create mode 100644 docs/results/probe_val.csv\n","\n","To 