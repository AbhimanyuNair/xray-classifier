{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyM6HkSX5AQI434s8QyavA5d"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"},"accelerator":"GPU"},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PeI9KgM3cBCj","executionInfo":{"status":"ok","timestamp":1791092951309,"user_tz":-330,"elapsed":177187,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"a8d00d9b-f086-4833-bef8-e38ec10ae8a4"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","            width  height\n","partition                \n","test       1280.0   892.5\n","train      1288.0   893.0\n","val        1264.0   848.0\n"]}],"source":["# CELL 4B.1 - Header + add image dimensions to splits.csv\n","from google.colab import drive, userdata\n","drive.mount('/content/drive')\n","import sys, shutil, importlib, json\n","sys.path.insert(0, '/content/drive/MyDrive/xray-classifier/src')\n","from project_setup import *\n","\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import torch.nn as nn\n","from torch.utils.data import DataLoader, WeightedRandomSampler\n","from sklearn.metrics import roc_auc_score\n","import xray_data, models, train_utils\n","\n","set_seed()\n","CONFIG = load_config()\n","\n","splits = pd.read_csv(PATHS[\"configs\"] / \"splits.csv\")\n","if \"width\" not in splits.columns:\n","    meta = pd.read_csv(PATHS[\"processed\"] / \"metadata.csv\")\n","    meta[\"cache_name\"] = meta.label + \"__\" + meta.filename.str.replace(r\"\\.\\w+$\", \"\", regex=True) + \".png\"\n","    splits = splits.merge(meta[[\"cache_name\", \"width\", \"height\"]], on=\"cache_name\", how=\"left\")\n","    assert splits.width.notna().all()\n","    splits.to_csv(PATHS[\"configs\"] / \"splits.csv\", index=False)\n","\n","LOCAL = Path(\"/content/img256\")\n","if not LOCAL.exists():\n","    shutil.copytree(PATHS[\"processed\"] / \"img256\", LOCAL)\n","loaders = xray_data.make_loaders(splits, LOCAL, CONFIG[\"img_size\"], CONFIG[\"batch_size\"], seed=SEED)\n","print(splits.groupby(\"partition\")[[\"width\", \"height\"]].median())"]},{"cell_type":"code","source":["# CELL 4B.2 - src/shortcut.py\n","module = '''\n","import numpy as np\n","from sklearn.metrics import roc_auc_score\n","\n","def fit_bin_edges(df, n_area=4, n_aspect=3):\n","    \"\"\"Bin edges from image dimensions only (no labels involved).\"\"\"\n","    area = np.log(df.width.to_numpy() * df.height.to_numpy())\n","    aspect = df.width.to_numpy() / df.height.to_numpy()\n","    return {\n","        \"area\": np.quantile(area, np.linspace(0, 1, n_area + 1)[1:-1]),\n","        \"aspect\": np.quantile(aspect, np.linspace(0, 1, n_aspect + 1)[1:-1]),\n","    }\n","\n","def assign_bins(df, edges):\n","    a = np.digitize(np.log(df.width.to_numpy() * df.height.to_numpy()), edges[\"area\"])\n","    r = np.digitize(df.width.to_numpy() / df.height.to_numpy(), edges[\"aspect\"])\n","    return a * (len(edges[\"aspect\"]) + 1) + r\n","\n","def compute_weights(df, bin_ids, min_per_class=3, clip=10.0):\n","    \"\"\"Weight = P(class) / P(class | bin). Inside each bin, both classes then carry the same\n","    share as in the whole set, so size and shape no longer predict the class.\"\"\"\n","    y = df.target.to_numpy()\n","    w = np.zeros(len(df))\n","    p_y = {c: (y == c).mean() for c in (0, 1)}\n","    for b in np.unique(bin_ids):\n","        m = bin_ids == b\n","        n_b = m.sum()\n","        counts = {c: int(((y == c) & m).sum()) for c in (0, 1)}\n","        if min(counts.values()) < min_per_class:\n","            continue\n","        for c in (0, 1):\n","            w[m & (y == c)] = p_y[c] * n_b / counts[c]\n","    w = np.minimum(w, clip)\n","    kept = w > 0\n","    w[kept] = w[kept] / w[kept].mean()\n","    return w\n","\n","def weighted_metrics(probs, ys, w, thr=0.5):\n","    keep = w > 0\n","    p, y, ww = probs[keep], ys[keep], w[keep]\n","    pred = (p >= thr).astype(int)\n","    tp = ww[(pred == 1) & (y == 1)].sum(); fn = ww[(pred == 0) & (y == 1)].sum()\n","    tn = ww[(pred == 0) & (y == 0)].sum(); fp = ww[(pred == 1) & (y == 0)].sum()\n","    return {\n","        \"auroc\": float(roc_auc_score(y, p, sample_weight=ww)),\n","        \"recall\": float(tp / (tp + fn)),\n","        \"specificity\": float(tn / (tn + fp)),\n","        \"images_used\": int(keep.sum()),\n","    }\n","'''\n","f = PATHS[\"src\"] / \"shortcut.py\"\n","f.write_text(module)\n","compile(f.read_text(), str(f), \"exec\")\n","print(\"Wrote and syntax-checked src/shortcut.py\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"l4E7MBxddoQQ","executionInfo":{"status":"ok","timestamp":1791093017234,"user_tz":-330,"elapsed":33,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"c66475e2-3b81-407b-80ce-6586078d706e"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Wrote and syntax-checked src/shortcut.py\n"]}]},{"cell_type":"code","source":["# CELL 4B.3 - Bins and weights per partition\n","import shortcut\n","importlib.reload(shortcut)\n","\n","edges = shortcut.fit_bin_edges(splits[splits.partition == \"train\"])\n","parts, W = {}, {}\n","for p in [\"train\", \"val\", \"test\"]:\n","    d = splits[splits.partition == p].reset_index(drop=True)\n","    bins = shortcut.assign_bins(d, edges)\n","    parts[p] = (d, bins)\n","    W[p] = shortcut.compute_weights(d, bins)\n","    print(f\"{p:5s}: kept {(W[p] > 0).sum()} of {len(d)} images\")\n","\n","d, bins = parts[\"train\"]\n","print(\"\\nTrain images per (size x shape) bin:\")\n","print(pd.crosstab(bins, d.label))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6CsyOJx0dq4h","executionInfo":{"status":"ok","timestamp":1791093027745,"user_tz":-330,"elapsed":202,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"363192ca-1562-4b19-e37b-270bb67ae280"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["train: kept 3133 of 4177 images\n","val  : kept 399 of 871 images\n","test : kept 516 of 808 images\n","\n","Train images per (size x shape) bin:\n","label  NORMAL  PNEUMONIA\n","row_0                   \n","0           0         54\n","1           1        274\n","2           1        714\n","3          17        132\n","4          18        419\n","5          14        443\n","6         164        254\n","7         118        317\n","8          30        161\n","9         605        165\n","10        134        111\n","11         18         13\n"]}]},{"cell_type":"code","source":["# CELL 4B.4 - Do the weights remove the size signal? Re-score the naive CNN\n","from sklearn.ensemble import GradientBoostingClassifier\n","tr, va = parts[\"train\"][0], parts[\"val\"][0]\n","y_v = va.target.to_numpy()\n","feats = lambda d: np.column_stack([d.width, d.height, d.width / d.height])\n","\n","gb = GradientBoostingClassifier(n_estimators=100, max_depth=2, random_state=SEED).fit(feats(tr), tr.target)\n","pg = gb.predict_proba(feats(va))[:, 1]\n","print(\"Geometry-only val AUROC, standard:     \", round(roc_auc_score(y_v, pg), 3))\n","print(\"Geometry-only val AUROC, size-adjusted:\", round(shortcut.weighted_metrics(pg, y_v, W[\"val\"])[\"auroc\"], 3))\n","\n","ckpt_naive = PATHS[\"models\"] / \"baseline_cnn.pt\"\n","naive = models.BaselineCNN().to(DEVICE)\n","naive.load_state_dict(torch.load(ckpt_naive, map_location=DEVICE))\n","p_n, _ = train_utils.predict(naive, loaders[\"val\"], DEVICE)\n","print(\"\\nNaive CNN, standard:     \", {k: round(v, 3) for k, v in train_utils.metrics_at(p_n, y_v).items() if k in (\"auroc\", \"recall\", \"specificity\")})\n","print(\"Naive CNN, size-adjusted:\", {k: round(v, 3) if isinstance(v, float) else v for k, v in shortcut.weighted_metrics(p_n, y_v, W[\"val\"]).items()})"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9SdBYAn8dry2","executionInfo":{"status":"ok","timestamp":1791093048969,"user_tz":-330,"elapsed":13237,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"8c9d4c34-dd86-487a-994a-c5a8c6c7d13a"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Geometry-only val AUROC, standard:      0.925\n","Geometry-only val AUROC, size-adjusted: 0.556\n","\n","Naive CNN, standard:      {'auroc': 0.992, 'recall': 0.949, 'specificity': 0.978}\n","Naive CNN, size-adjusted: {'auroc': 0.966, 'recall': 0.843, 'specificity': 0.969, 'images_used': 399}\n"]}]},{"cell_type":"code","source":["# CELL 4B.5 - Retrain with size-balanced sampling\n","set_seed()\n","tr_df = parts[\"train\"][0]\n","train_tf, _ = xray_data.get_transforms(CONFIG[\"img_size\"])\n","g = torch.Generator().manual_seed(SEED)\n","sampler = WeightedRandomSampler(torch.tensor(W[\"train\"], dtype=torch.double),\n","                                num_samples=int((W[\"train\"] > 0).sum()), replacement=True, generator=g)\n","loaders_adj = {\n","    \"train\": DataLoader(xray_data.XrayDataset(tr_df, LOCAL, train_tf), batch_size=CONFIG[\"batch_size\"],\n","                        sampler=sampler, num_workers=2, pin_memory=True),\n","    \"val\": loaders[\"val\"], \"test\": loaders[\"test\"],\n","}\n","\n","metric_fn = lambda p, y: shortcut.weighted_metrics(p, y, W[\"val\"])\n","\n","model_adj = models.BaselineCNN().to(DEVICE)\n","criterion = nn.BCEWithLogitsLoss()\n","optimizer = torch.optim.AdamW(model_adj.parameters(), lr=1e-3, weight_decay=1e-4)\n","history_adj = train_utils.fit(model_adj, loaders_adj, criterion, optimizer, DEVICE, epochs=15, patience=5,\n","                              ckpt_path=PATHS[\"models\"] / \"baseline_cnn_adjusted.pt\", metric_fn=metric_fn)\n","history_adj.to_csv(PATHS[\"outputs\"] / \"baseline_adjusted_history.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kzKFZzuKdvO0","e