eturn len(self.loader)\n","\n","    def __iter__(self):\n","        for x, y in self.loader:\n","            yield torch.where(self.mask, self.black.expand_as(x), x), y\n","'''\n","    f.write_text(code)\n","compile(f.read_text(), str(f), \"exec\")\n","import explain\n","importlib.reload(explain)\n","\n","set_seed()\n","CONFIG = load_config()\n","FIG = PATHS[\"docs\"] / \"figures\"\n","\n","LOCAL = Path(\"/content/img256\")\n","if not LOCAL.exists():\n","    shutil.copytree(PATHS[\"processed\"] / \"img256\", LOCAL)\n","\n","splits = pd.read_csv(PATHS[\"configs\"] / \"splits.csv\")\n","loaders = xray_data.make_loaders(splits, LOCAL, CONFIG[\"img_size\"], CONFIG[\"batch_size\"], seed=SEED)\n","\n","edges = shortcut.fit_bin_edges(splits[splits.partition == \"train\"])\n","dfs, W = {}, {}\n","for p in [\"train\", \"val\", \"test\"]:\n","    d = splits[splits.partition == p].reset_index(drop=True)\n","    dfs[p] = d\n","    W[p] = shortcut.compute_weights(d, shortcut.assign_bins(d, edges))\n","y = {p: dfs[p].target.to_numpy() for p in dfs}\n","\n","masks = explain.region_masks()\n","M = (xray_data.IMAGENET_MEAN, xray_data.IMAGENET_STD)\n","ld_A = {\"val\": loaders[\"val\"], \"test\": loaders[\"test\"]}\n","ld_B = {k: explain.MaskedLoader(v, masks[\"periphery\"], *M) for k, v in ld_A.items()}\n","\n","def load_model(path):\n","    m = models.DenseNetClassifier(pretrained=False).to(DEVICE)\n","    m.load_state_dict(torch.load(path, map_location=DEVICE))\n","    m.eval()\n","    return m\n","\n","net_A = load_model(PATHS[\"models\"] / \"densenet_sizebalanced.pt\")\n","net_B = load_model(PATHS[\"models\"] / \"densenet_centeronly.pt\")\n","\n","# Validation only\n","pv = {\"A\": train_utils.predict(net_A, ld_A[\"val\"], DEVICE)[0],\n","      \"B\": train_utils.predict(net_B, ld_B[\"val\"], DEVICE)[0]}\n","aucv = {k: shortcut.weighted_metrics(v, y[\"val\"], W[\"val\"])[\"auroc\"] for k, v in pv.items()}\n","print(\"Validation adjusted AUROC:\", {k: round(v, 3) for k, v in aucv.items()}, \"(expect A 0.994, B 0.994)\")\n","headline = \"B\" if aucv[\"B\"] >= aucv[\"A\"] - 0.005 else \"A\"\n","print(\"Headline model by the pre-declared rule:\", headline)"]},{"cell_type":"code","source":["# CELL 7.2 - Choose thresholds on VALIDATION (target: catch 95% of pneumonia, size-adjusted)\n","def pick_threshold(probs, y_, w, target=0.95):\n","    keep = w > 0\n","    fpr, tpr, th = roc_curve(y_[keep], probs[keep], sample_weight=w[keep])\n","    i = int(np.argmax(tpr >= target))\n","    return float(th[i]), float(tpr[i]), float(1 - fpr[i])\n","\n","thr = {}\n","for k in [\"A\", \"B\"]:\n","    thr[k], r, s = pick_threshold(pv[k], y[\"val\"], W[\"val\"])\n","    print(f\"Model {k}: threshold {thr[k]:.3f} -> val adjusted recall {r:.3f}, specificity {s:.3f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DrNVO8AXQiwa","executionInfo":{"status":"ok","timestamp":1792414986207,"user_tz":-330,"elapsed":44,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"27057ca8-0990-4b39-d6ba-491674bce10e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Model A: threshold 0.276 -> val adjusted recall 0.959, specificity 0.982\n","Model B: threshold 0.734 -> val adjusted recall 0.954, specificity 0.981\n"]}]},{"cell_type":"code","source":["# CELL 7.3 - OPEN THE TEST SET (run once)\n","print(\"Running the sealed test set once for both pre-declared models.\")\n","pt = {\"A\": train_utils.predict(net_A, ld_A[\"test\"], DEVICE)[0],\n","      \"B\": train_utils.predict(net_B, ld_B[\"test\"], DEVICE)[0]}\n","\n","# Reference floor: geometry-only model (no pixels)\n","tr, te = dfs[\"train\"], dfs[\"test\"]\n","feats = lambda d: np.column_stack([d.width, d.height, d.width / d.height])\n","gb = GradientBoostingClassifier(n_estimators=100, max_depth=2, random_state=SEED).fit(feats(tr), tr.target)\n","pt[\"Geometry-only\"] = gb.predict_proba(feats(te))[:, 1]\n","\n","out = dfs[\"test\"][[\"cache_name\", \"patient_id\", \"label\", \"subtype\", \"target\"]].copy()\n","out[\"prob_A\"], out[\"prob_B\"], out[\"prob_geometry\"] = pt[\"A\"], pt[\"B\"], pt[\"Geometry-only\"]\n","out.to_csv(PATHS[\"docs\"] / \"results\" / \"test_predictions.csv\", index=False)\n","print(\"Saved docs/results/test_predictions.csv\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qCOS-ueXQkfJ","executionInfo":{"status":"ok","timestamp":1792415004190,"user_tz":-330,"elapsed":10653,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"44717d93-a427-4ce2-e174-d57ab60c7488"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Running the sealed test set once for both pre-declared models.\n","Saved docs/results/test_predictions.csv\n"]}]},{"cell_type":"code","source":["# CELL 7.4 - Test metrics with patient-level bootstrap 95% CIs\n","def boot(df, probs, w, t, n_boot=1000):\n","    rng = np.random.default_rng(SEED)\n","    groups = df.groupby(\"patient_id\").indices\n","    pids = np.array(list(groups.keys()))\n","    yy = df.target.to_numpy()\n","    res = []\n","    for _ in range(n_boot):\n","        idx = np.concatenate([groups[p] for p in rng.choice(pids, size=len(pids), replace=True)])\n","        try:\n","            u = train_utils.metrics_at(probs[idx], yy[idx], t)\n","            a = shortcut.weighted_metrics(probs[idx], yy[idx], w[idx], t)\n","        except ValueError:\n","            continue\n","        res.append([u[\"auroc\"], u[\"recall\"], u[\"specificity\"], a[\"auroc\"], a[\"recall\"], a[\"specificity\"]])\n","    return np.array(res)\n","\n","def fmt(point, arr):\n","    lo, hi = np.nanpercentile(arr, [2.5, 97.5])\n","    return f\"{point:.3f} [{lo:.3f}, {hi:.3f}]\"\n","\n","cols = [\"AUROC std\", \"recall std\", \"spec std\", \"AUROC adj\", \"recall adj\", \"spec adj\"]\n","rows = []\n","for k, t in [(\"A\", thr[\"A\"]), (\"B\", thr[\"B\"]), (\"Geometry-only\", 0.5)]:\n","    probs = pt[k]\n","    u = train_utils.metrics_at(probs, y[\"test\"], t)\n","    a = shortcut.weighted_metrics(probs, y[\"test\"], W[\"test\"], t)\n","    pts = [u[\"auroc\"], u[\"recall\"], u[\"specificity\"], a[\"auroc\"], a[\"recall\"], a[\"specificity\"]]\n","    arr = boot(dfs[\"test\"], probs, W[\"test\"], t)\n","    row = {\"model\": k, \"threshold\": round(t, 3)}\n","    row.update({c: fmt(p, arr[:, j]) for j, (c, p) in enumerate(zip(cols, pts))})\n","    rows.append(row)\n","final = pd.DataFrame(rows)\n","print(final.to_string(index=False))\n","print(\"Adjusted evaluation uses\", int((W[\"test\"] > 0).sum()), \"of\", len(W[\"test\"]), \"test images\")\n","final.to_csv(PATHS[\"docs\"] / \"results\" / \"test_metrics.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nbDRIuQ8RUBl","executionInfo":{"status":"ok","timestamp":1792415202617,"user_tz":-330,"elapsed":14302,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"e25fcebc-eba5-4b14-8e27-aeb729964672"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["        model  threshold            AUROC std           recall std             spec std            AUROC adj           recall adj             spec adj\n","            A      0.276 0.997 [0.994, 0.998] 0.967 [0.952, 0.981] 0.970 [0.948, 0.988] 0.993 [0.987, 0.998] 0.935 [0.897, 0.972] 0.968 [0.938, 0.990]\n","            B      0.734 0.993 [0.988, 0.997] 0.953 [0.932, 0.971] 0.970 [0.948, 0.989] 0.990 [0.980, 0.997] 0.924 [0.880, 0.964] 0.968 [0.939, 0.990]\n","Geometry-only      0.500 0.908 [0.881, 0.932] 0.890 [0.856, 0.920] 0.703 [0.637, 0.765] 0.534 [0.448, 0.628] 0.578 [0.495, 0.670] 0.468 [0.382, 0.573]\n","Adjusted evaluation uses 516 of 808 test images\n"]}]},{"cell_type":"code","source":["# CELL 7.5 - Breakdown by pneumonia subtype + error list (headline model)\n","hm = headline\n","t, probs = thr[hm], pt[hm]\n","d = dfs[\"test\"].copy()\n","d[\"pred\"] = (probs >= t).astype(int)\n","d[\"correct\"] = (d.pred == d.target).astype(int)\n","d[\"w\"] = W[\"test\"]\n","\n","def summarize(mask, name):\n","    s = d[mask]\n","    wk = s[s.w > 0]\n","    return {\"group\": name, \"n\": len(s), \"rate (all)\": round(float(s.correct.mean()), 3),\n","            \"n adj\": len(wk),\n","            \"rate (adj)\": round(float((wk.w * wk.correct).sum() / wk.w.sum()), 3) if len(wk) else np.nan}\n","\n","sub = pd.DataFrame([\n","    summarize(d.subtype == \"bacteria\", \"bacterial pneumonia (recall)\"),\n","    summarize(d.subtype == \"virus\", \"viral pneumonia (recall)\"),\n","    summarize(d.label == \"NORMAL\", \"normal (specificity)\"),\n","])\n","print(f\"Headline model {hm}, threshold {t:.3f}\")\n","print(sub.to_string(index=False))\n","\n","wrong = d.correct.to_numpy() == 0\n","errors = d[wrong][[\"cache_name\", \"patient_id\", \"label\", \"subtype\"]].assign(prob=np.round(probs[wrong], 3))\n","errors.to_csv(PATHS[\"docs\"] / \"results\" / \"test_errors.csv\", index=False)\n","print(\"Missed pneumonia:\", int(((d.target == 1) & (d.pred == 0)).sum()),\n","      \"| False alarms:\", int(((d.target == 0) & (d.pred == 1)).sum()))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JlidsOASRj4p","executionInfo":{"status":"ok","timestamp":1792415253398,"user_tz":-330,"elapsed":70,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"80dc399c-90fe-4cfd-a000-f3ea5611b8f7"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Headline model B, threshold 0.734\n","                       group   n  rate (all)  n adj  rate (adj)\n","bacterial pneumonia (recall) 364       0.962    178       0.925\n","    viral pneumonia (recall) 208       0.938    103       0.922\n","        normal (specificity) 236       0.970    235       0.968\n","Missed pneumonia: 27 | False alarms: 7\n"]}]},{"cell_type":"code","source":["# CELL 7.6 - ROC curves (standard and size-adjusted)\n","fig, ax = plt.subplots(1, 2, figsize=(11, 4.5))\n","for k, lab in [(\"A\", \"A: full image\"), (\"B\", \"B: center only\"), (\"Geometry-only\", \"geometry-only (no pixels)\")]:\n","    for a_, w_, title in [(ax[0], None, \"Standard\"), (ax[1], W[\"test\"], \"Size-adjusted\")]:\n","        if w_ is None:\n","            fpr, tpr, _ = roc_curve(y[\"test\"], pt[k])\n","        else:\n","            keep = w_ > 0\n","            fpr, tpr, _ = roc_curve(y[\"test\"][keep], pt[k][keep], sample_weight=w_[keep])\n","        a_.plot(fpr, tpr, label=lab)\n","        a_.set_title(f\"ROC, {title}\")\n","for a_ in ax:\n","    a_.plot([0, 1], [0, 1], \"k:\", lw=1)\n","    a_.set_xlabel(\"False positive rate\"); a_.set_ylabel(\"True positive rate\"); a_.legend()\n","plt.tight_layout()\n","plt.savefig(FIG / \"test_roc.png\", dpi=150)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":330},"id":"6q0HrNwjRk6I","executionInfo":{"status":"ok","timestamp":1792415273265,"user_tz":-330,"elapsed":1910,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"f5d5fdfb-24ef-41b4-8384-8b22b061591d"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1100x450 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# CELL 7.7 - Phase 7 decisions\n","entries = f\"\"\"\n","## Decision 44: Operating thresholds chosen on validation for 95% size-adjusted recall, then applied once to test\n","- Thresholds: A {thr['A']:.3f}, B {thr['B']:.3f}\n","- Limitation: chosen on only {int((W['val'] > 0).sum())} adjusted validation images, so test recall can differ\n","\n","## Decision 45: Patient-level bootstrap (1000 resamples) for 95% confidence intervals\n","- Why: images from one patient are not independent; resampling images would give intervals that are too narrow\n","- Limitation: size-adjusted weights are computed once on the test set, not recomputed per resample\n","\n","## D