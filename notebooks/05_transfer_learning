{"cells":[{"cell_type":"code","source":["# CELL 5.0 - Pre-flight check after a long break\n","from google.colab import drive, userdata\n","drive.mount('/content/drive')\n","import sys, requests\n","sys.path.insert(0, '/content/drive/MyDrive/xray-classifier/src')\n","import torch, torchvision\n","from project_setup import *\n","\n","print(\"GPU:\", torch.cuda.is_available(), \"| torch\", torch.__version__, \"| torchvision\", torchvision.__version__)\n","for p in sorted(PATHS[\"src\"].glob(\"*.py\")):\n","    compile(p.read_text(), str(p), \"exec\")\n","    print(\"OK:\", p.name)\n","\n","need = {\n","    \"split file\": PATHS[\"configs\"] / \"splits.csv\",\n","    \"image cache\": PATHS[\"processed\"] / \"img256\",\n","    \"naive baseline\": PATHS[\"models\"] / \"baseline_cnn.pt\",\n","    \"adjusted baseline\": PATHS[\"models\"] / \"baseline_cnn_adjusted.pt\",\n","    \"4B results\": PATHS[\"docs\"] / \"results\" / \"size_adjusted_val.csv\",\n","}\n","for k, p in need.items():\n","    print((\"[x] \" if p.exists() else \"[ ] \") + k)\n","print(\"Phase 5 models already saved:\", [p.name for p in PATHS[\"models\"].glob(\"densenet*.pt\")])\n","\n","r = requests.get(\"https://api.github.com/repos/\" + userdata.get(\"GITHUB_USERNAME\") + \"/xray-classifier\",\n","                 headers={\"Authorization\": \"Bearer \" + userdata.get(\"GITHUB_TOKEN\")})\n","print(\"GitHub token check:\", r.status_code, \"(200 = valid, 401 = expired)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5swSyi26X1Mm","executionInfo":{"status":"ok","timestamp":1792333015336,"user_tz":-330,"elapsed":3514,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"01d1e1f9-272b-4b93-d220-4b35bd9006f3"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","GPU: True | torch 2.11.0+cu130 | torchvision 0.26.0+cu130\n","OK: models.py\n","OK: project_setup.py\n","OK: shortcut.py\n","OK: train_utils.py\n","OK: xray_data.py\n","[x] split file\n","[x] image cache\n","[x] naive baseline\n","[x] adjusted baseline\n","[x] 4B results\n","Phase 5 models already saved: ['densenet_plain.pt']\n","GitHub token check: 200 (200 = valid, 401 = expired)\n"]}]},{"cell_type":"code","execution_count":4,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":99126,"status":"ok","timestamp":1792333186141,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"},"user_tz":-330},"id":"kFl0rMcoiOGV","outputId":"b32dee77-f364-4843-a9d6-4dffa54f9229"},"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Device: cuda | val images used in adjusted eval: 399\n"]}],"source":["# CELL 5.1 - Header + data + size-adjusted weights\n","from google.colab import drive, userdata\n","drive.mount('/content/drive')\n","import sys, shutil, importlib, json, time\n","sys.path.insert(0, '/content/drive/MyDrive/xray-classifier/src')\n","from project_setup import *\n","\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import torch.nn as nn\n","from torch.utils.data import DataLoader, WeightedRandomSampler\n","from sklearn.metrics import roc_auc_score\n","import xray_data, models, train_utils, shortcut\n","\n","set_seed()\n","CONFIG = load_config()\n","FIG = PATHS[\"docs\"] / \"figures\"\n","\n","LOCAL = Path(\"/content/img256\")\n","if not LOCAL.exists():\n","    shutil.copytree(PATHS[\"processed\"] / \"img256\", LOCAL)\n","\n","splits = pd.read_csv(PATHS[\"configs\"] / \"splits.csv\")\n","loaders = xray_data.make_loaders(splits, LOCAL, CONFIG[\"img_size\"], CONFIG[\"batch_size\"], seed=SEED)\n","\n","edges = shortcut.fit_bin_edges(splits[splits.partition == \"train\"])\n","parts, W = {}, {}\n","for p in [\"train\", \"val\", \"test\"]:\n","    d = splits[splits.partition == p].reset_index(drop=True)\n","    parts[p] = d\n","    W[p] = shortcut.compute_weights(d, shortcut.assign_bins(d, edges))\n","y_v = parts[\"val\"].target.to_numpy()\n","\n","# Training loader with size-balanced sampling\n","train_tf, _ = xray_data.get_transforms(CONFIG[\"img_size\"])\n","g = torch.Generator().manual_seed(SEED)\n","sampler = WeightedRandomSampler(torch.tensor(W[\"train\"], dtype=torch.double),\n","                                num_samples=int((W[\"train\"] > 0).sum()), replacement=True, generator=g)\n","loaders_adj = {\n","    \"train\": DataLoader(xray_data.XrayDataset(parts[\"train\"], LOCAL, train_tf), batch_size=CONFIG[\"batch_size\"],\n","                        sampler=sampler, num_workers=2, pin_memory=True),\n","    \"val\": loaders[\"val\"], \"test\": loaders[\"test\"],\n","}\n","print(\"Device:\", DEVICE, \"| val images used in adjusted eval:\", int((W[\"val\"] > 0).sum()))"]},{"cell_type":"code","execution_count":5,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2,"status":"ok","timestamp":1792333210885,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"},"user_tz":-330},"id":"Dag4pPHpknAI","outputId":"b2ed9ee8-31dc-4136-809b-0bd02b8b417a"},"outputs":[{"output_type":"stream","name":"stdout","text":["models.py OK: ['BaselineCNN', 'DenseNetClassifier']\n"]}],"source":["# CELL 5.2 - Add DenseNet121 classifier to src/models.py\n","f = PATHS[\"src\"] / \"models.py\"\n","code = f.read_text()\n","if \"class DenseNetClassifier\" not in code:\n","    code += '''\n","\n","class DenseNetClassifier(nn.Module):\n","    \"\"\"ImageNet-pretrained DenseNet121 with a new 1-logit head.\"\"\"\n","    def __init__(self, pretrained=True, dropout=0.2):\n","        super().__init__()\n","        from torchvision import models as tvm\n","        weights = tvm.DenseNet121_Weights.DEFAULT if pretrained else None\n","        self.net = tvm.densenet121(weights=weights)\n","        self.net.classifier = nn.Sequential(nn.Dropout(dropout), nn.Linear(self.net.classifier.in_features, 1))\n","\n","    def forward(self, x):\n","        return self.net(x).squeeze(1)\n","'''\n","    f.write_text(code)\n","compile(f.read_text(), str(f), \"exec\")\n","importlib.reload(models)\n","print(\"models.py OK:\", [n for n in dir(models) if n.endswith(\"CNN\") or n.endswith(\"Classifier\")])"]},{"cell_type":"code","execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":4106,"status":"ok","timestamp":1792333219919,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"},"user_tz":-330},"id":"ufa5nw9TkqXN","outputId":"02775969-572e-4680-f1c0-2068d15ce2b3"},"outputs":[{"output_type":"stream","name":"stdout","text":["Downloading: \"https://download.pytorch.org/models/densenet121-a639ec97.pth\" to /root/.cache/torch/hub/checkpoints/densenet121-a639ec97.pth\n"]},{"output_type":"stream","name":"stderr","text":["100%|██████████| 30.8M/30.8M [00:00<00:00, 108MB/s] \n"]},{"output_type":"stream","name":"stdout","text":["Output shape: (32,) (expect (32,))\n","Parameters: 6954881\n","Initial loss: 0.795\n"]}],"source":["# CELL 5.3 - Sanity check (downloads pretrained weights the first time)\n","m = models.DenseNetClassifier().to(DEVICE)\n","xb, yb = next(iter(loaders[\"train\"]))\n","with torch.no_grad():\n","    out = m(xb.to(DEVICE))\n","print(\"Output shape:\", tuple(out.shape), \"(expect (32,))\")\n","print(\"Parameters:\", sum(p.numel() for p in m.parameters()))\n","print(\"Initial loss:\", round(nn.BCEWithLogitsLoss()(out, yb.float().to(DEVICE)).item(), 3))\n","del m"]},{"cell_type":"code","execution_count":7,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"V2zM-YB1k8Jx","outputId":"f7c3e0af-d660-4ae4-de12-990f548dc8a0","executionInfo":{"status":"ok","timestamp":1792333575785,"user_tz":-330,"elapsed":342213,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["No finished E1 found: training now.\n","ep 01 | train 0.176 | val 0.077 | AUROC 0.985 | recall 0.866 | spec 0.974 | 48s  <- best\n","ep 02 | train 0.086 | val 0.071 | AUROC 0.987 | recall 0.875 | spec 1.000 | 47s  <- best\n","ep 03 | train 0.066 | val 0.064 | AUROC 0.990 | recall 0.970 | spec 0.960 | 49s  <- best\n","ep 04 | train 0.053 | val 0.057 | AUROC 0.990 | recall 0.915 | spec 0.982 | 49s\n","ep 05 | train 0.043 | val 0.069 | AUROC 0.988 | recall 0.913 | spec 0.992 | 49s\n","ep 06 | train 0.036 | val 0.099 | AUROC 0.987 | recall 0.894 | spec 0.992 | 50s\n","ep 07 | train 0.035 | val 0.211 | AUROC 0.984 | recall 0.826 | spec 0.992 | 49s\n","Early stop: no AUROC improvement for 4 epochs.\n"]}],"source":["# CELL 5.4 (resume version) - define runner; reuse E1 if it already finished\n","metric_fn = lambda p, y: shortcut.weighted_metrics(p, y, W[\"val\"])\n","\n","def run_experiment(name, ld, epochs=10, patience=4, lr=1e-4):\n","    set_seed()\n","    net = models.DenseNetClassifier().to(DEVICE)\n","    opt = torch.optim.AdamW(net.parameters(), lr=lr, weight_decay=1e-4)\n","    hist = train_utils.fit(net, ld, nn.BCEWithLogitsLoss(), opt, DEVICE, epochs=epochs,\n","                           patience=patience, ckpt_path=PATHS[\"models\"] / f\"{name}.pt\", metric_fn=metric_fn)\n","    hist.to_csv(PATHS[\"outputs\"] / f\"{name}_history.csv\", index=False)\n","    return net, hist\n","\n","hist_path = PATHS[\"outputs\"] / \"densenet_plain_history.csv\"\n","ckpt_path = PATHS[\"models\"] / \"densenet_plain.pt\"\n","if hist_path.exists() and ckpt_path.exists():\n","    hist_e1 = pd.read_csv(hist_path)\n","    net_e1 = models.DenseNetClassifier(pretrained=False).to(DEVICE)\n","    net_e1.load_state_dict(torch.load(ckpt_path, map_location=DEVICE))\n","    print(\"Loaded finished E1 from Drive:\")\n","    print(hist_e1.round(3).to_string(index=False))\n","else:\n","    print(\"No finished E1 found: training now.\")\n","    net_e1, hist_e1 = run_experiment(\"densenet_plain\", loaders)"]},{"cell_type":"code","source":["# CELL 5.5 - E2: DenseNet121, size-balanced sampling\n","net_e2, hist_e2 = run_experiment(\"densenet_sizebalanced\", loaders_adj)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SrNOg0wEaI3E","executionInfo":{"status":"ok","timestamp":1792333884491,"user_tz":-330,"elapsed":267697,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"6df221b2-6a18-4fcd-f5ce-90265921e922"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["ep 01 | train 0.230 | val 0.123 | AUROC 0.988 | recall 0.947 | spec 0.943 | 39s  <- best\n","ep 02 | train 0.104 | val 0.095 | AUROC 0.988 | recall 0.910 | spec 0.996 | 38s\n","ep 03 | train 0.073 | val 0.092 | AUROC 0.994 | recall 0.931 | spec 0.986 | 38s  <- best\n","ep 04 | train 0.051 | val 0.086 | AUROC 0.992 | recall 0.941 | spec 0.979 | 38s\n","ep 05 | train 0.046 | val 0.107 | AUROC 0.978 | recall 0.969 | spec 0.828 | 38s\n","ep 06 | train 0.037 | val 0.069 | AUROC 0.990 | recall 0.934 | spec 0.968 | 38s\n","ep 07 | train 0.029 | val 0.095 | AUROC 0.993 | recall 0.955 | spec 0.982 | 38s\n","Early stop: no AUROC improvement for 4 epochs.\n"]}]},{"cell_type":"code","source":["# CELL 5.6 - Comparison on validation (all models)\n","prev = pd.read_csv(PATHS[\"docs\"] / \"results\" / \"size_adjusted_val.csv\")\n","rows = []\n","def add_row(name, probs):\n","    u = train_utils.metrics_at(probs, y_v)\n","    a = shortcut.weighted_metrics(probs, y_v, W[\"val\"])\n","    rows.append({\"model\": name, \"AUROC standard\": u[\"auroc\"], \"AUROC adjusted\": a[\"auroc\"],\n","                 \"recall adj\": a[\"recall\"], \"specificity adj\": a[\"specificity\"]})\n","\n","for name, net in [(\"DenseNet121 plain\", net_e1), (\"DenseNet121 size-balanced\", net_e2)]:\n","    p, _ = train_utils.predict(net, loaders[\"val\"], DEVICE)\n","    add_row(name, p)\n","\n","res5 = pd.concat([prev, pd.DataFrame(rows).round(3)], ignore_index=True)\n","print(res5.to_string(index=False))\n","res5.to_csv(PATHS[\"docs\"] / \"results\" / \"model_comparison_val.csv\", index=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_XFbTmzKbUam","executionInfo":{"status":"ok","timestamp":1792333933866,"user_tz":-330,"elapsed":7774,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"c4a68d67-9228-4964-9d56-88c2f655a7f6"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["                    model  AUROC standard  AUROC adjusted  recall adj  specificity adj\n","geometry-only (no pixels)           0.925           0.556       0.467            0.603\n","                naive CNN           0.992           0.966       0.843            0.969\n","        size-adjusted CNN           0.976           0.962       0.888            0.929\n","        DenseNet121 plain           0.997           0.990       0.970            0.960\n","DenseNet121 size-balanced           0.997           0.994       0.931            0.986\n"]}]},{"cell_type":"code","source":["# CELL 5.7 - Curves\n","fig, ax = plt.subplots(1, 2, figsize=(12, 4))\n","for h, lab in [(hist_e1, \"plain\"), (hist_e2, \"size-balanced\")]:\n","    ax[0].plot(h.epoch, h.val_auroc, label=lab)\n","    ax[1].plot(h.epoch, h.val_loss, label=lab)\n","ax[0].set_title(\"Size-adjusted val AUROC\"); ax[0].set_xlabel(\"epoch\"); ax[0].legend()\n","ax[1].set_title(\"Val loss\"); ax[1].set_xlabel(\"epoch\"); ax[1].legend()\n","plt.tight_layout(); plt.savefig(FIG / \"densenet_curves.png\", dpi=150); plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":250},"id":"euU3Zj1GcSE5","executionInfo":{"status":"ok","timestamp":1792334180122,"user_tz":-330,"elapsed":888,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"5f6c393a-d9c9-409b-9dcc-0a08b1a3dbe8"},"execution_count":10,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# CELL 5.8 - Phase 5 decisions\n","r1 = res5[res5.model == \"DenseNet121 plain\"].iloc[0]\n","r2 = res5[res5.model == \"DenseNet121 size-balanced\"].iloc[0]\n","entries = f\"\"\"\n","## Decision 31: ImageNet-pretrained DenseNet121 as the Phase 5 model\n","- Why: widely used in chest X-ray work, and pretrained features need far less data than training from scratch\n","- Alternatives not tried yet: ResNet50, EfficientNet\n","- Interview one-liner: \"I used transfer learning from ImageNet because medical datasets are small.\"\n","\n","## Decision 32: Full fine-tuning with AdamW, learning rate 1e-4\n","- Why: pretrained weights are already good, so smaller steps (10x lower than the scratch model) avoid destroying them\n","- No scheduler, to keep runs simple and comparable\n","\n","## Decision 33: Both runs selected by size-adjusted validation AUROC\n","- Why: only one variable differs between runs (sampling), so the comparison is fair\n","- E1 plain sampling: AUROC standard {r1['AUROC standard']:.3f}, adjusted {r1['AUROC adjusted']:.3f}, recall adj {r1['recall adj']:.3f}, specificity adj {r1['specificity adj']:.3f}\n","- E2 size-balanced sampling: AUROC standard {r2['AUROC standard']:.3f}, adjusted {r2['AUROC adjusted']:.3f}, recall adj {r2['recall adj']:.3f}, specificity adj {r2['specificity adj']:.3f}\n","\n","## Decision 34: Compare every model under both standard and size-adjusted metrics\n","- Why: the size shortcut makes standard metrics alone misleading\n","\n","## Decision 35: Test set still sealed\n","- Why: it is evaluated once, in Phase 6\n","\n","### Comparison on validation (all models)\n","{res5.to_string(index=False)}\n","\"\"\"\n","append_decision(entries)\n","print(\"Decisions logged (duplicates skipped).\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NsyOneuScVyy","executionInfo":{"status":"ok","timestamp":1792334194673,"user_tz":-330,"elapsed":459,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"0f9819d6-9b1b-475d-d727-aa7dc5b87ab3"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Decisions logged (duplicates skipped).\n"]}]},{"cell_type":"code","source":["# CELL 5.8b - Model choice and order decisions\n","entries = \"\"\"\n","## Decision 36: DenseNet121 size-balanced is the single candidate for final evaluation\n","- Rule (set before touching the test set): highest size-adjusted validation AUROC\n","- Evidence: 0.994 vs 0.990 for plain sampling (difference is within noise on 399 images)\n","- Why only one model goes to the test set: scoring several models on test and keeping the best inflates the final number\n","- Interview one-liner: \"I fixed the selection rule before opening the test set and evaluated one candidate.\"\n","\n","## Decision 37: Explainability on validation images before the final test evaluation\n","- Why: if heatmaps show the model reading text markers or borders, we fix it before the test set is opened, instead of being tempted to tune on test results\n","- Interview one-liner: \"I audited what the model looked at before spending the test set.\"\n","\"\"\"\n","append_decision(entries)\n","print(\"Decisions logged (duplicates skipped).\")"],"metadata":{"id":"qTe148thce4Z","executionInfo":{"status":"ok","timestamp":1792334235852,"user_tz":-330,"elapsed":14,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"2300c746-9066-4184-c805-6462f3539a9f","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Decisions logged (duplicates skipped).\n"]}]},{"cell_type":"code","source":["# CELL 5.9 - Push Phase 5\n","git_push(\"Phase 5: DenseNet121 transfer learning, comparison and decisions\",\n","         userdata.get(\"GITHUB_USERNAME\"),\n","         userdata.get(\"GITHUB_TOKEN\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yIeClVSHcYo9","executionInfo":{"status":"ok","timestamp":1792334244938,"user_tz":-330,"elapsed":6966,"user":{"displayName":"Abhimanyu Nair","userId":"02668314908528652463"}},"outputId":"8d539663-14f3-40d8-f362-9b20f484e4e7"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["[main afebd66] Phase 5: DenseNet121 transfer learning, comparison and decisions\n"," 2 files changed, 11 insertions(+), 1 deletion(-)\n","\n","To https://github.com/AbhimanyuNair/xray-classifier.git\n","   d149ca4..afebd66  HEAD -> main\n","\n"]}]}],"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyOWAGdJbWPA1Eq8njMSnkcy"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"},"accelerator":"GPU"},"nbformat":4,"nbformat_minor":0}